{
  "manifest_version": 3,
  "name": "理享厨房预约助手",
  "version": "1.2.2",
  "description": "按北京时间预约浙理共享厨房，支持日期、时段、厨房优先顺序和人数。",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "power"],
  "action": {
    "default_title": "理享厨房预约助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://zhst.zstu.edu.cn/statusweb/h5/universityFrontOfficeProgram/*"],
      "js": ["rules.js", "booking.js"],
      "run_at": "document_idle"
    }
  ]
}
