{
  "manifest_version": 3,
  "name": "理享厨房预约助手",
  "version": "1.4.3",
  "description": "按北京时间预约浙理共享厨房，支持日期、时段、厨房优先顺序和人数。",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "power", "webNavigation", "debugger"],
  "host_permissions": ["https://ie.zstu.edu.cn/*", "https://sso.zstu.edu.cn/*", "https://zhst.zstu.edu.cn/*"],
  "action": {
    "default_title": "理享厨房预约助手",
    "default_popup": "quick.html",
    "default_icon": {
      "16": "icons/kitchen-16.png",
      "24": "icons/kitchen-24.png",
      "32": "icons/kitchen-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://zhst.zstu.edu.cn/statusweb/h5/universityFrontOfficeProgram/*"],
      "js": ["booking-language.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://zhst.zstu.edu.cn/statusweb/h5/universityFrontOfficeProgram/*"],
      "js": ["rules.js", "booking.js", "environment-check.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ie.zstu.edu.cn/zstu-portal-mobile-web/*", "https://ie.zstu.edu.cn/zstu-apps-mobile-web/*"],
      "js": ["environment-check.js", "environment-entry.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://zhst.zstu.edu.cn/statusweb/h5/universityFrontOfficeProgram/*"],
      "js": ["environment-entry.js"],
      "run_at": "document_idle"
    }
  ]
}
